{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps && node build-api.cjs",
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/public",
  "functions": {
    "api/trpc/[trpc].mjs": {
      "memory": 512,
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/trpc/:path*",
      "destination": "/api/trpc/[trpc].mjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
